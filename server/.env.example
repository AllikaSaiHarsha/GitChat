PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
# Optional: cap on failed login/register/join attempts per IP per 15 min
# RATE_LIMIT_MAX=20
# Behind a proxy (Cloudflare/Render/Fly/nginx) set the trusted hop count so
# rate limits key on the real client IP. Leave unset when directly exposed.
# TRUST_PROXY=1
# MongoDB - Atlas free tier (M0) recommended, or local mongod
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chat
